{
  "version": 2,
  "functions": {
    "server.mjs": { "includeFiles": ["admin/index.html", "work/index.html"] }
  },
  "builds": [
    { "src": "api/index.mjs", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "payment-callback.html", "use": "@vercel/static" },
    { "src": "pages/**", "use": "@vercel/static" },
    { "src": "user/**", "use": "@vercel/static" },
    { "src": "work/**", "use": "@vercel/static" },
    { "src": "admin/**", "use": "@vercel/static" },
    { "src": "scripts/**", "use": "@vercel/static" },
    { "src": "styles/**", "use": "@vercel/static" },
    { "src": "images/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.mjs" },
    { "src": "/work/?$", "dest": "/server.mjs" },
    { "src": "/admin-dashboard/?$", "dest": "/server.mjs" },
    { "src": "/admin", "dest": "/admin/login.html" },
    { "src": "/admin/", "dest": "/admin/login.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}